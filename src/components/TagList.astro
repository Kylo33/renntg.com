---
interface Props {
    tags: string[];
}
let { tags } = Astro.props;
---

<div class="flex gap-2 flex-wrap">
    {
        tags.map((tag) => (
            <div class="bg-pine-muted-bg rounded-full py-1 px-4 text-sm text-pine-dark">
                {tag}
            </div>
        ))
    }
</div>
